{
  "name": "@web3settle/merchant-sdk",
  "version": "0.7.0",
  "description": "React SDK for accepting crypto payments via Web3Settle (EVM + TRON)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "./dist/wc.js",
    "./dist/wc.cjs",
    "./src/wc/index.ts",
    "./src/wc/pay-button.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tron": {
      "types": "./dist/tron.d.ts",
      "import": "./dist/tron.js",
      "require": "./dist/tron.cjs"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "require": "./dist/headless.cjs"
    },
    "./wc": {
      "types": "./dist/wc.d.ts",
      "import": "./dist/wc.js",
      "require": "./dist/wc.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "audit:ci": "npm audit --audit-level=high",
    "prepublishOnly": "npm ci --ignore-scripts && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@wagmi/core": "^3.6.7",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tronweb": "^6.3.0",
    "viem": "^2.57.10",
    "wagmi": "^3.7.9"
  },
  "peerDependenciesMeta": {
    "@wagmi/core": {
      "optional": true
    },
    "tronweb": {
      "optional": true
    },
    "viem": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "i18next": "26.5.6",
    "react-i18next": "17.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@wagmi/core": "^3.6.7",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.0",
    "tronweb": "^6.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "viem": "^2.57.10",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "wagmi": "^3.7.9"
  },
  "overrides": {
    "axios": "^1.17.0",
    "hono": "^4.12.23",
    "fast-uri": "^3.1.2",
    "rpc-websockets": {
      "uuid": "^11.1.1"
    },
    "lodash": "^4.18.1",
    "follow-redirects": "^1.16.1",
    "esbuild": "^0.28.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public",
    "provenance": true
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web3settle/merchant-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/web3settle/merchant-sdk/issues"
  },
  "homepage": "https://github.com/web3settle/merchant-sdk#readme",
  "keywords": [
    "web3",
    "crypto",
    "payments",
    "react",
    "sdk",
    "blockchain",
    "ethereum",
    "base",
    "tron",
    "trx",
    "wagmi",
    "viem"
  ]
}
