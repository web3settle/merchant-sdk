# The dependency graph cannot be resolved under npm's default strict peer rules:
# eslint-plugin-jsx-a11y@6.10.2 (its latest) declares `eslint: ^3 … ^9`, while this
# package pins eslint ^10. The committed package-lock.json was already generated
# with legacy peer resolution — without this file `npm ci` fails ERESOLVE on a
# clean checkout, which is why CI has been red independently of any source change.
#
# Making the mode explicit keeps local installs, `npm ci`, and the lockfile in
# agreement. Remove it once eslint-plugin-jsx-a11y ships an eslint@10 peer range.
legacy-peer-deps=true
